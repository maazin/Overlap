# Copy to .env and adjust. Nothing here is secret in development.

# API
PORT=8080
APP_ENV=development
DATABASE_URL=postgres://overlap:overlap@localhost:5434/overlap?sslmode=disable

# Comma-separated allowlist. The deployed value must include the Vercel origin,
# scheme and all, or the browser fetch fails CORS while curl keeps working.
ALLOWED_ORIGINS=http://localhost:5173

# Where the browser app lives. The API writes this into the URL field of every
# downloaded .ics so the calendar entry links back to the event.
#
# Set this in production. It has a working local default, which means getting
# it wrong is silent: the .ics still downloads and still imports, carrying a
# link to a localhost that only exists on the organizer's laptop.
WEB_URL=http://localhost:5173

# Applies pending migrations at startup. Set to "false" only if something else
# owns schema changes for this database.
RUN_MIGRATIONS=true

# How often expired events are deleted. Set to 0 to disable the sweep.
PURGE_INTERVAL=6h

# Rate limiting for the endpoints that write rows without needing a token.
# Burst is how many requests one address may make at once; per-minute is the
# sustained rate it refills at. Set RATE_LIMIT_PER_MINUTE=0 to disable.
RATE_LIMIT_BURST=20
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_MAX_KEYS=20000

# Which header carries the real client address. Leave empty when the server is
# reachable directly: trusting a header nothing upstream overwrites lets a
# client mint a fresh rate limit bucket per request.
#
# Comma-separated, in order of preference; the first one present on a request
# wins. Fly-Client-IP on Fly. True-Client-IP, CF-Connecting-IP on Render, which
# runs behind Cloudflare.
#
# Prefer single-value headers a proxy overwrites. X-Forwarded-For is a list, and
# behind two proxies its last entry is an internal hop that changes per request,
# which gives every request its own bucket and disables limiting entirely.
CLIENT_IP_HEADER=

# How long a computed group proposal is reused before the calendars behind it
# are refreshed. This caps outbound calendar fetches by event rather than by
# caller, which is what a per-address limit cannot do on an endpoint that takes
# no token. Set to 0 to recompute every time.
PROPOSAL_COOLDOWN=30s

# Web (SvelteKit reads PUBLIC_ prefixed vars in the browser)
PUBLIC_API_URL=http://localhost:8080
