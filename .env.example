# Copy to .env and adjust. Nothing here is secret in development.

# API
PORT=8080
APP_ENV=development
DATABASE_URL=postgres://overlap:overlap@localhost:5434/overlap?sslmode=disable

# Comma-separated allowlist. The deployed value must include the Vercel origin,
# scheme and all, or the browser fetch fails CORS while curl keeps working.
ALLOWED_ORIGINS=http://localhost:5173

# Where the browser app lives. The API writes this into the URL field of every
# downloaded .ics so the calendar entry links back to the event.
#
# Set this in production. It has a working local default, which means getting
# it wrong is silent: the .ics still downloads and still imports, carrying a
# link to a localhost that only exists on the organizer's laptop.
WEB_URL=http://localhost:5173

# Applies pending migrations at startup. Set to "false" only if something else
# owns schema changes for this database.
RUN_MIGRATIONS=true

# How often expired events are deleted. Set to 0 to disable the sweep.
PURGE_INTERVAL=6h

# Web (SvelteKit reads PUBLIC_ prefixed vars in the browser)
PUBLIC_API_URL=http://localhost:8080
