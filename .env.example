# Copy to .env and adjust. Nothing here is secret in development.

# API
PORT=8080
APP_ENV=development
DATABASE_URL=postgres://overlap:overlap@localhost:5434/overlap?sslmode=disable
# Comma-separated allowlist. The deployed value must include the Vercel origin.
ALLOWED_ORIGINS=http://localhost:5173

# Web (SvelteKit reads PUBLIC_ prefixed vars in the browser)
PUBLIC_API_URL=http://localhost:8080
